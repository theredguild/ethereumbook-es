{
  "name": "mastering-ethereum-es-419",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "predev": "npm run prepare:site",
    "dev": "vite",
    "prebuild": "npm run prepare:site",
    "build": "vite build",
    "prepare:site": "node scripts/prepare-vocs.mjs && npm run build:labs",
    "build:labs": "npm run setup:contracts && npm run verify:zk && vite build --config labs/vite.config.mjs && node scripts/prepare-lab-assets.mjs && node scripts/prepare-lab-sources.mjs",
    "setup:zk": "node scripts/build-zk-artifacts.mjs",
    "setup:contracts": "node scripts/build-contract-artifacts.mjs",
    "setup:licenses": "node scripts/prepare-lab-assets.mjs && node scripts/prepare-runtime-licenses.mjs",
    "verify:zk": "node scripts/verify-zk-artifacts.mjs",
    "test:labs": "npm run setup:contracts && npm run verify:zk && node --test labs/*/*.test.mjs",
    "preview": "vocs preview",
    "prepreview:host": "npm run build",
    "preview:host": "vocs preview --host 0.0.0.0 --port 5173"
  },
  "devDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@noble/hashes": "2.4.0",
    "@openzeppelin/contracts": "5.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "poseidon-lite": "0.3.0",
    "pyodide": "0.27.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "7.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "snarkjs": "0.7.5",
    "solc": "0.8.30",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "viem": "2.57.7",
    "vite": "8.3.4",
    "vocs": "2.10.3",
    "waku": "1.0.0-rc.3"
  }
}
