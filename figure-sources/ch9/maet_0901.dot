digraph ReentradaSoloLectura {
  graph [rankdir=LR, bgcolor="transparent", pad=0.3, nodesep=0.7, ranksep=1.3, fontname="DejaVu Sans", fontsize=22, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#e2f0f8", color="#17212b", fontname="DejaVu Sans", fontsize=24, penwidth=2, margin="0.22,0.18"];
  edge [color="#17212b", fontcolor="#17212b", fontname="DejaVu Sans", fontsize=20, penwidth=2, arrowsize=0.85];
  atacante [label="Contrato del atacante"];
  b [label="Contrato B"];
  a [label="Contrato A"];
  atacante -> b [label="3. Llama a"];
  b -> a [label="4. Lee datos de"];
  atacante -> a [label="1. Interactúa con", constraint=false];
  a -> atacante [label="2. Activa una llamada\nde retorno a", constraint=false];
}
